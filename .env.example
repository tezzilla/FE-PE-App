# Database. SQLite for local dev. For production switch provider to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the site (used for Stripe redirects)
APP_URL="http://localhost:3000"

# Stripe. Leave blank in local dev to use the fake billing flow (dev only). See docs/STRIPE.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "true" turns on Stripe Tax in Checkout. Only after Tax settings are active in Stripe.
STRIPE_AUTOMATIC_TAX=""
# Optional: explicit price IDs. Normally prices are found by lookup key (npm run stripe:setup).
STRIPE_PRICE_FE_CIVIL=""
STRIPE_PRICE_PE_CIVIL=""
STRIPE_PRICE_ALL_ACCESS=""

# Optional: comma-separated emails that get the reviewer role (Review queue access).
REVIEWER_EMAILS=""

# Public contact email shown on the Terms and Privacy pages.
CONTACT_EMAIL=""

# Postmark (transactional email: password reset, welcome, password changed).
# Server API token from Postmark > Servers > your server > API Tokens. Mark it Sensitive in Vercel.
POSTMARK_SERVER_TOKEN=""
# Verified sender signature or domain in Postmark, e.g. "CivilPrep <support@yourdomain.com>"
EMAIL_FROM=""

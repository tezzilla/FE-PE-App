# Database. SQLite for local dev. For production switch provider to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the site (used for Stripe redirects)
APP_URL="http://localhost:3000"

# Stripe. Leave blank in local dev to use the fake billing flow (dev only).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FE_CIVIL=""
STRIPE_PRICE_PE_CIVIL=""
STRIPE_PRICE_ALL_ACCESS=""

# Optional: comma-separated emails that get the reviewer role (Review queue access).
REVIEWER_EMAILS=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  createdAt            DateTime  @default(now())
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // "fe-civil" | "pe-civil" | "all-access"
  plan                 String?
  // Mirrors Stripe subscription status: active, trialing, past_due, canceled, ...
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // "user" | "reviewer" | "admin"
  role                 String    @default("user")
  // Shown to students next to reviewed problems, e.g. "Passed FE and PE Civil: WRE". Change to "P.E." once licensed.
  reviewerCredential   String?
  attempts             Attempt[]
  mockExams            MockExam[]
  reviews              TemplateReview[]
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  exam       String
  topic      String
  selected   Int
  correct    Boolean
  createdAt  DateTime @default(now())

  @@index([userId, exam])
}

model MockExam {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam       String
  total      Int
  correct    Int
  durationS  Int
  createdAt  DateTime @default(now())

  @@index([userId, exam])
}

model TemplateReview {
  id              String    @id @default(cuid())
  templateId      String
  templateVersion Int
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id])
  // in_progress | approved | rejected | changes_requested
  status          String
  // JSON: [{ seed, given, correct, match }]
  samples         String
  notes           String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([templateId, templateVersion])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  createdAt            DateTime  @default(now())
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // "fe-civil" | "pe-civil" | "all-access"
  plan                 String?
  // Mirrors Stripe subscription status: active, trialing, past_due, canceled, ...
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // "user" | "reviewer" | "admin"
  role                 String    @default("user")
  // Shown to students next to reviewed problems, e.g. "Passed FE and PE Civil: WRE". Change to "P.E." once licensed.
  reviewerCredential   String?
  // PE depth module the student is taking (topic slug). Shapes PE readiness weights.
  peDepth              String?
  attempts             Attempt[]
  mockExams            MockExam[]
  reviews              TemplateReview[]
  reports              ProblemReport[]
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  exam       String
  topic      String
  selected   Int
  correct    Boolean
  createdAt  DateTime @default(now())

  @@index([userId, exam])
}

model MockExam {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam       String
  total      Int
  correct    Int
  durationS  Int
  createdAt  DateTime @default(now())

  @@index([userId, exam])
}

model TemplateReview {
  id              String    @id @default(cuid())
  templateId      String
  templateVersion Int
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id])
  // in_progress | approved | rejected | changes_requested
  status          String
  // JSON: [{ seed, given, correct, match }]
  samples         String
  notes           String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([templateId, templateVersion])
}

// Fixed-window counters for login/signup rate limiting (shared across serverless instances).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Student-submitted "this question is wrong/unclear" reports, triaged by reviewers.
model ProblemReport {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  exam        String
  topic       String
  templateId  String?
  selected    Int?
  message     String
  // open | resolved | dismissed
  status      String    @default("open")
  resolverNote String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
}

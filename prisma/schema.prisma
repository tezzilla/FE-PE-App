generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String
  // Bumped on password change; tokens carry it, so older sessions stop working everywhere.
  sessionVersion       Int       @default(0)
  createdAt            DateTime  @default(now())
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // "fe-civil" | "pe-civil" | "all-access"
  plan                 String?
  // Mirrors Stripe subscription status: active, trialing, past_due, canceled, ...
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // Access granted by one-time passes (stacked), per exam. Derived from Pass rows; see lib/passes.ts.
  feAccessUntil        DateTime?
  peAccessUntil        DateTime?
  // "user" | "reviewer" | "admin"
  role                 String    @default("user")
  // Shown to students next to reviewed problems, e.g. "Passed FE and PE Civil: WRE". Change to "P.E." once licensed.
  reviewerCredential   String?
  // PE depth module the student is taking (topic slug). Shapes PE readiness weights.
  peDepth              String?
  attempts             Attempt[]
  mockExams            MockExam[]
  reviews              TemplateReview[]
  reports              ProblemReport[]
  passes               Pass[]
  resetTokens          PasswordResetToken[]
  studyPlans           StudyPlan[]
  cardReviews          CardReview[]
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  exam       String
  topic      String
  selected   Int
  correct    Boolean
  // Seconds-level pacing: time from showing the question to checking the answer (practice only).
  timeMs     Int?
  createdAt  DateTime @default(now())

  @@index([userId, exam])
}

model MockExam {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam       String
  total      Int
  correct    Int
  durationS  Int
  createdAt  DateTime @default(now())
  // Full exams are saved while in progress so a refresh or crash doesn't lose a 5-hour attempt.
  // in_progress | completed
  status     String   @default("completed")
  // JSON: string[][] question ids per session, fixed at start (grading uses these, not the client's list).
  sessions   String?
  // JSON: { [topic]: [correct, total] }
  breakdown  String?
  // JSON: { [questionId]: choiceIndex } and flagged ids, saved at submission for later review.
  answers    String?
  completedAt DateTime?

  @@index([userId, exam])
}

model TemplateReview {
  id              String    @id @default(cuid())
  templateId      String
  templateVersion Int
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id])
  // in_progress | approved | rejected | changes_requested
  status          String
  // JSON: [{ seed, given, correct, match }]
  samples         String
  notes           String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([templateId, templateVersion])
}

// Fixed-window counters for login/signup rate limiting (shared across serverless instances).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Student-submitted "this question is wrong/unclear" reports, triaged by reviewers.
model ProblemReport {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  exam        String
  topic       String
  templateId  String?
  selected    Int?
  message     String
  // open | resolved | dismissed
  status      String    @default("open")
  resolverNote String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
}

// One-time purchase of fixed-length access (e.g. FE 3-month pass). One row per paid Checkout Session.
model Pass {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String
  checkoutSessionId String    @unique
  paymentIntentId   String?   @unique
  amountTotal       Int
  startsAt          DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  /** When we emailed "your pass ends soon" for this pass. */
  remindedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Password reset links. Only a SHA-256 hash of the token is stored; tokens are single-use and expire.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A student's exam date and weekly study time for one exam; the plan itself is computed (lib/adaptive/plan.ts).
model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        String
  examDate    DateTime
  weeklyHours Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, exam])
}

// Spaced-repetition state for one flashcard (lib/content/flashcards.ts) for one user.
model CardReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  /** Days until the next review after a successful answer. */
  interval  Float    @default(0)
  ease      Float    @default(2.5)
  reps      Int      @default(0)
  lapses    Int      @default(0)
  due       DateTime
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId, due])
}

// People who asked for a free sample problem set. Marketing email only if they opted in.
model Lead {
  id             String   @id @default(cuid())
  email          String
  exam           String
  source         String   @default("sample-pdf")
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([email, exam])
}

// A pass bought as a gift. The recipient redeems the code on their own account.
model GiftCode {
  id                String    @id @default(cuid())
  code              String    @unique
  plan              String
  purchaserEmail    String
  recipientEmail    String
  message           String?
  checkoutSessionId String    @unique
  paymentIntentId   String?   @unique
  amountTotal       Int
  redeemedById      String?
  redeemedAt        DateTime?
  voidedAt          DateTime?
  createdAt         DateTime  @default(now())
}

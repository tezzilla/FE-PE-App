{
  "name": "fe-pe-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "test:content": "tsx scripts/validate-questions.ts",
    "test:templates": "tsx scripts/validate-templates.ts",
    "test:adaptive": "tsx scripts/test-adaptive.ts",
    "make-reviewer": "tsx scripts/make-reviewer.ts",
    "vercel-build": "node scripts/postgres-schema.mjs && prisma generate --schema prisma/generated/postgres.prisma && prisma db push --skip-generate --schema prisma/generated/postgres.prisma && next build",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.17",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
